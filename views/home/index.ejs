
<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <span class="hero-badge">
        Your everyday shopping destination
      </span>

      <h1>
        Everything you love,
        <span>all in one place.</span>
      </h1>

      <p class="hero-description">
        Discover products for your lifestyle, upgrade your essentials,
        and find something you'll love—all at OrderNow.
      </p>

      <div class="hero-actions">
        <a href="/products" class="hero-button hero-button-primary">
          Explore Products
          <span aria-hidden="true">→</span>
        </a>

        <a href="#why-ordernow" class="hero-button hero-button-secondary">
          Why OrderNow?
        </a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <strong>Wide</strong>
          <span>Product selection</span>
        </div>

        <div class="trust-divider" aria-hidden="true"></div>

        <div class="trust-item">
          <strong>Easy</strong>
          <span>Shopping experience</span>
        </div>

        <div class="trust-divider" aria-hidden="true"></div>

        <div class="trust-item">
          <strong>Secure</strong>
          <span>Checkout experience</span>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-label="Shopping illustration">
      <div class="hero-decoration hero-decoration-one"></div>
      <div class="hero-decoration hero-decoration-two"></div>

      <div class="hero-shopping-card">
        <span class="shopping-card-label">YOUR NEXT FAVORITE</span>

        <div class="shopping-illustration" aria-hidden="true">
          <div class="illustration-circle"></div>
          <div class="illustration-bag">
            <div class="bag-handle"></div>
            <div class="bag-front">
              <span>O</span>
            </div>
          </div>
          <div class="illustration-spark spark-one">✦</div>
          <div class="illustration-spark spark-two">✧</div>
        </div>

        <div class="shopping-card-footer">
          <div>
            <strong>Discover more.</strong>
            <p>Find your everyday favorites.</p>
          </div>

          <span class="shopping-card-arrow" aria-hidden="true">↗</span>
        </div>
      </div>

      <div class="floating-note floating-note-top">
        <span class="floating-note-icon">✦</span>
        <span>Made for your lifestyle</span>
      </div>

      <div class="floating-note floating-note-bottom">
        <span class="floating-note-dot"></span>
        <span>Something for everyone</span>
      </div>
    </div>
  </div>
</section>

<%- include("categories") %>
<%- include("featured-products") %>
<%- include("benefits") %>
<%- include("newsletter") %>
<section class="hero-followup" id="why-ordernow">
  <div class="container">
    <p>One destination. Countless possibilities.</p>
  </div>
</section>

