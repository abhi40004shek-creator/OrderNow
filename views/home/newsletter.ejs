
<section class="newsletter-section" aria-labelledby="newsletter-title">
  <div class="container">
    <div class="newsletter-card">
      <div class="newsletter-content">
        <span class="newsletter-eyebrow">THE ORDERNOW COMMUNITY</span>

        <h2 id="newsletter-title">
          Get the Best Deals in Your Inbox
        </h2>

        <p>
          Subscribe for exclusive offers, new arrivals, and shopping
          inspiration delivered straight to your inbox.
        </p>
      </div>

      <form class="newsletter-form" action="#" method="GET">
        <label class="visually-hidden" for="newsletter-email">
          Email address
        </label>

        <input
          id="newsletter-email"
          type="email"
          name="email"
          placeholder="Enter your email address"
          autocomplete="email"
          required
        />

        <button type="submit">Subscribe</button>
      </form>

      <p class="newsletter-note">
        Stay updated with OrderNow. You can unsubscribe anytime.
      </p>
    </div>
  </div>
</section>
