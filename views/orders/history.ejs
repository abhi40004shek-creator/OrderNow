<link rel="stylesheet" href="/css/order-history.css" />
<main class="order-history-page">
  <section class="order-history-container">
    <header class="order-history-header">
      <h1>My Orders</h1>
      <p>View your orders and track their current status.</p>
    </header>

    <div id="order-history-feedback" role="status" aria-live="polite"></div>

   
<div id="order-history-list">
  <% if (orders.length === 0) { %>
    <p class="order-history-empty">
      You haven't placed any orders yet.
    </p>
  <% } else { %>
    <% orders.forEach((order) => { %>
      <article class="order-history-card">
        <header class="order-history-card-header">
          <h2>Order #<%= order.id %></h2>
          <span class="order-history-status">
            <%= order.status %>
          </span>
        </header>

        <div class="order-history-meta">
          <p>
            <strong>Order Date</strong>
            <%= new Date(order.createdAt).toLocaleString("en-IN") %>
          </p>

          <p>
            <strong>Order Total</strong>
            ₹<%= Number(order.total).toLocaleString("en-IN") %>
          </p>
        </div>

        <div class="order-history-items">
          <h3>Products</h3>

          <% order.items.forEach((item) => { %>
            <div class="order-history-item">
              <span>
                <%= item.image %>
                <%= item.name %> × <%= item.quantity %>
              </span>

              <span>
                ₹<%= (item.price * item.quantity).toLocaleString("en-IN") %>
              </span>
            </div>
          <% }); %>
        </div>

         <div class="order-history-actions">
           <a
              href="/api/orders/<%= encodeURIComponent(order.id) %>/details"
              class="btn btn-primary"
            >
              View Details
            </a>
           </div>

      </article>
    <% }); %>
  <% } %>
</div>


    <div class="order-history-actions">
      <a href="/" class="btn btn-primary">Continue Shopping</a>
    </div>
  </section>
</main>
